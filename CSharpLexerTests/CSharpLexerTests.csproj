<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0;net48</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Parlot" Version="2.2.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CSharpLexerOracle\CSharpLexerOracle.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- TabularEditor is a Windows Forms application, so what is tested is compiled into this project -->
    <Compile Include="..\TabularEditor\TextServices\CSharpToken.cs" Link="Linked\CSharpToken.cs" />
    <Compile Include="..\TabularEditor\TextServices\CSharpTokenizer.cs" Link="Linked\CSharpTokenizer.cs" />
    <Compile Include="..\TabularEditor\TextServices\CSharpLexerToken.cs" Link="Linked\CSharpLexerToken.cs" />
  </ItemGroup>
</Project>
